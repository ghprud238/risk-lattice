# =================================================================
# RiskLattice Backend Configuration
# =================================================================

# Local LLM Runtime (Ollama / vLLM / LM Studio / Mock)
# Set to 'false' to invoke a live local LLM; 'true' for offline deterministic mock responses
MOCK_LLM=true

# Model Identifier (LiteLLM syntax)
# Local Ollama:  ollama/qwen2.5:14b-instruct-q4_K_M or ollama/llama3.1:8b
# Local vLLM:    openai/qwen-2.5-14b
# Cloud BYOK:    anthropic/claude-3-5-sonnet-20241022 or gpt-4o
RISK_LATTICE_LLM_MODEL=ollama/qwen2.5:14b-instruct-q4_K_M
CONTAGION_LLM_MODEL=ollama/qwen2.5:14b-instruct-q4_K_M

# Local LLM API Base
OLLAMA_API_BASE=http://localhost:11434

# Optional Cloud API Keys (if using cloud providers instead of local Ollama)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Server & Network
HOST=0.0.0.0
PORT=5051

# Optional Minsky Dynamic Equilibrium Simulator
MINSKY_ENABLED=false
